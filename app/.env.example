# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5002
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ===== TRANSLATION SERVICE CONFIGURATION =====
# Choose your translation service: 'deepl' (free, default) or 'openrouter' (paid)
TRANSLATION_SERVICE=deepl

# ===== DeepL API Configuration (FREE - DEFAULT) =====
# Get your free API key at: https://www.deepl.com/pro-api
# Free tier: 500,000 characters/month (no credit card required)
# For paid accounts, change the URL in rag_service.py to: https://api.deepl.com/v2/translate
DEEPL_API_KEY=1f789fcf-7065-47c8-a5b9-10e499928c62:fx

# ===== OpenRouter API Configuration (PAID - OPTIONAL) =====
# Get your API key at: https://openrouter.ai/
# Only needed if you set TRANSLATION_SERVICE=openrouter
OPENROUTER_API_KEY=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

# Model selection for OpenRouter (optional)
# Primary model (high quality, paid)
OPENROUTER_MODEL=openai/gpt-4-turbo
# Fallback model (free, lower quality)
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.2-3b-instruct:free

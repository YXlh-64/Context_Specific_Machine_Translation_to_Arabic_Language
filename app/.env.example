# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5002
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ===== GEMMA LOCAL MODEL CONFIGURATION =====
# Uses local GPU for translation - no API costs!

# Model ID from HuggingFace Hub
GEMMA_MODEL_ID=ModelSpace/GemmaX2-28-9B-v0.1

# Device mapping: 'auto' (recommended), 'cuda', or 'cpu'
GEMMA_DEVICE_MAP=auto

# Maximum tokens to generate for each translation
GEMMA_MAX_NEW_TOKENS=512

# Enable 8-bit quantization to reduce memory usage (requires bitsandbytes)
GEMMA_LOAD_IN_8BIT=false

# Enable 4-bit quantization for even lower memory usage (requires bitsandbytes)
GEMMA_LOAD_IN_4BIT=false

# Skip model preloading at startup (set to 'true' to load only on first request)
# Useful during development to avoid reloading on every code change
SKIP_MODEL_PRELOAD=false
